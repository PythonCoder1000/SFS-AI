# Copy this file to .env and fill in whichever credential you're using.
# .env itself is gitignored -- never commit real keys.

# Option A: direct Anthropic API (preferred, per hackathon spec sec 7 --
# better docs, structured outputs confirmed stable). Get one at
# console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY=

# Option B: AWS Bedrock (used automatically if ANTHROPIC_API_KEY is
# unset). AWS_SESSION_TOKEN only needed for temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
