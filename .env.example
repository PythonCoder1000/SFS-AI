# Copy this file to .env and fill in whichever credential you're using.
# .env itself is gitignored -- never commit real keys.

# Option A: direct Anthropic API (preferred, per hackathon spec sec 7 --
# better docs, structured outputs confirmed stable). Get one at
# console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY=

# Option B: AWS Bedrock (used automatically if ANTHROPIC_API_KEY is
# unset). AWS_SESSION_TOKEN only needed for temporary credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Weave/W&B -- eligibility requirement (hackathon spec sec 0). Without
# this, weave.init() is skipped entirely (controller.py checks for it
# first -- see the 2026-09-12 finding there: calling weave.init() with
# no key blocks forever on an interactive login prompt instead of
# failing cleanly, so this project gates on the key being present
# rather than letting that happen). Get one at wandb.ai/authorize, or
# use the $100 W&B Inference credit from the hackathon sponsor table.
WANDB_API_KEY=
